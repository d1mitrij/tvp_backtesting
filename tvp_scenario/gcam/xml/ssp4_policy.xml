<!--
  ssp4_policy.xml — SSP4-6.0 Inequality (polarised ~3 °C pathway)
  ================================================================
  Narrative: stark inequality between and within countries.
  High-tech, capital-intensive energy systems in wealthy regions (Europe,
  urban Asia); labour-intensive, fossil-dependent systems in low-income
  regions (Africa, rural Asia, parts of LATAM). ~3 °C trajectory.

  KEY SSP4 DISTINCTION: polarisation, not uniform fragmentation (SSP3).
    Europe → rapid decarbonisation (strong institutions, Rail_EU_DEV)
    Africa → very slow (limited capital, Proj_002 hospital serves tiny elite)

  Carbon prices [$/tonne CO2]:
    Africa:  8→25    (low capacity, limited enforcement)
    Asia:   28→120   (divergent — urban strict, rural weak; net intermediate)
    Europe: 100→500  (consistent with SSP1-level institutional ambition)
    LATAM:  20→80    (intermediate-loose, bifurcated economy)

  Renewable electricity standard:
    Africa:  26%→30%   (floor only — no investment capacity for ambition)
    Asia:    26%→75%   (rapid urban-sector deployment)
    Europe:  44%→98%   (near-full decarbonisation, mirrors SSP1)
    LATAM:   50%→76%
-->
<scenario>

  <!-- Africa: very low carbon price — limited enforcement capacity -->
  <policy-portfolio-standard type="GHG" name="co2_tax_africa_e4">
