<!--
  project_params.xml — Project-calibrated GCAM parameter overrides
  ================================================================
  Applied to ALL policy scenarios via project.xml <xmlEdit>.
  Generated values are cross-checked by derive_parameters.py.

  COAL THERMAL EFFICIENCY
  -----------------------
  GCAM fixes the coal emission coefficient at ~95 kgCO2/GJ (bituminous, HHV).
  We adjust the thermal efficiency of each region's coal fleet so that the
  effective output emission factor matches the avoided-CO2 evidence from
  hydro_finance_input.csv:

    Africa : 0.3964 Mt CO2/PJ_elec → implied eff = 95 / (0.3964×1000) = 23.97 %
    Asia   : 0.4641 Mt CO2/PJ_elec → implied eff = 95 / (0.4641×1000) = 20.47 %
    Europe : 0.2775 Mt CO2/PJ_elec → implied eff = 95 / (0.2775×1000) = 34.23 %
    LATAM  : 0.2200 Mt CO2/PJ_elec → implied eff = 95 / (0.2200×1000) = 43.18 %
             (no hydro project; LATAM grid is gas-heavy → lower effective EF)

  The efficiency is applied to the "coal (conv pul)" subsector (conventional
  pulverised coal), which dominates the fleet in developing-region GCAM scenarios.

  HYDRO RETROFIT CAPACITY (from hydro_finance_input.csv)
  -------------------------------------------------------
  Budget at $1,000/kW gives maximum new HYDRO_RETRO capacity.
  Converted to EJ/yr using regional capacity factors:
    Africa : 0.030 GW × 40% CF × 31.536 PJ/(GW·yr) × 1e-3 = 3.784e-4 EJ/yr
    Asia   : 0.150 GW × 38% CF × 31.536 PJ/(GW·yr) × 1e-3 = 1.797e-3 EJ/yr
    Europe : 0.002 GW × 35% CF × 31.536 PJ/(GW·yr) × 1e-3 = 2.207e-5 EJ/yr
    LATAM  : 0.000 GW (no project)

  These are modelled as fixed-output additions in GCAM's hydro subsector,
  available from 2025 onward once project construction is complete.

  RAIL ELECTRICITY DEMAND (from rail_finance_input.csv)
  ------------------------------------------------------
  Rail_EU_DEV: 5.5 M pax/yr × 5 kWh/pax × 3.6e-9 PJ/kWh = 0.0990 PJ/yr
  = 9.90e-5 EJ/yr added to Europe's transportation final demand from 2025.
-->

<scenario>

  <!-- ── Africa: coal fleet efficiency (23.97 %) ───────────────────────── -->
  <global-technology-database>
    <location-info sector-name="electricity" subsector-name="coal (conv pul)"
                   region="Africa_Eastern">
      <technology name="coal (conv pul)">
        <period year="2020"><efficiency>0.2397</efficiency></period>
        <period year="2025"><efficiency>0.2397</efficiency></period>
        <period year="2030"><efficiency>0.2500</efficiency></period>
        <period year="2035"><efficiency>0.2600</efficiency></period>
        <period year="2040"><efficiency>0.2700</efficiency></period>
        <period year="2045"><efficiency>0.2800</efficiency></period>
        <period year="2050"><efficiency>0.2900</efficiency></period>
      </technology>
    </location-info>
