  <!-- ── Rail electricity demand (Rail_EU_DEV, Europe, 9.90e-5 EJ/yr) ── -->
  <!--
    Add Rail_EU_DEV electricity consumption to Europe's passenger transport
    final demand from 2025 onward.
    5.5M pax × 5 kWh/pax × 3.6e-12 EJ/kWh = 9.90e-8 EJ/yr
    Note: small relative to GCAM EJ resolution; included for completeness.
  -->
  <region name="EU-15">
    <energybalance-final-demand name="trn_pass">
      <!-- Rail_EU_DEV incremental electricity demand [EJ/yr] -->
      <base-service year="2025">9.90e-8</base-service>
    </energybalance-final-demand>
  </region>

</scenario>
