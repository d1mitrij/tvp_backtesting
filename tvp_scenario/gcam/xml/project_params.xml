  <!-- ── Hydro retrofit fixed-output additions (2025+) ────────────────── -->
  <!--
    GCAM hydro is typically modelled as a fixed resource. We add small
    fixed-output contributions representing the retrofit projects.
    Values are in EJ/yr (see header comments for derivation).
  -->

  <!-- Africa: Hydro_AF — 0.030 GW at 40% CF = 3.784e-4 EJ/yr -->
  <region name="Africa_Eastern">
    <supplysector name="electricity">
      <subsector name="hydro">
        <technology name="hydro">
          <period year="2025"><fixedOutput>0.000189</fixedOutput></period>
          <period year="2030"><fixedOutput>0.000189</fixedOutput></period>
          <period year="2035"><fixedOutput>0.000189</fixedOutput></period>
          <period year="2040"><fixedOutput>0.000189</fixedOutput></period>
          <period year="2045"><fixedOutput>0.000189</fixedOutput></period>
          <period year="2050"><fixedOutput>0.000189</fixedOutput></period>
